{
    "name": "nawasara/sync",
    "description": "DB-cached + queue-based sync infrastructure for Nawasara packages (WHM, Cloudflare, Keycloak, etc.)",
    "type": "library",
    "license": "MIT",
    "autoload": {
        "psr-4": {
            "Nawasara\\Sync\\": "src/"
        }
    },
    "require": {
        "php": "^8.1",
        "illuminate/support": "^10.0|^12.0",
        "spatie/laravel-permission": "^6.0",
        "nawasara/ui": "*",
        "livewire/livewire": "^3.0"
    },
    "extra": {
        "laravel": {
            "providers": [
                "Nawasara\\Sync\\SyncServiceProvider"
            ]
        }
    }
}
